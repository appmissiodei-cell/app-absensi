# Salin ke .env.local, isi dari Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dipakai di SERVER saja: scripts/seed-users.ts (manual, sekali, dari lokal) dan menu
# Pengaturan > Kelola User (tambah user / buat password baru). Di Vercel isi sebagai
# Environment Variable biasa (JANGAN pakai awalan NEXT_PUBLIC_).
# JANGAN commit, JANGAN pernah dipakai di kode yang jalan di browser.
SUPABASE_SERVICE_ROLE_KEY=
